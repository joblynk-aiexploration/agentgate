generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  ACTIVE
  PAUSED
  SUSPENDED
  DISABLED
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum MembershipRole {
  platform_owner
  org_owner
  security_admin
  developer
  reviewer
  auditor
}

enum AgentStatus {
  ACTIVE
  PAUSED
  LOCKED
  DISABLED
}

enum AgentRiskTier {
  LOW
  STANDARD
  HIGH
  CRITICAL
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ToolType {
  SLACK
  STRIPE
  GMAIL
  EMAIL_PREVIEW
  HUBSPOT
  SALESFORCE
  GITHUB
  POSTGRES
  WEBHOOK
  CUSTOM
}

enum ToolConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  DISABLED
  DEMO
}

enum PolicyStatus {
  ACTIVE
  DRAFT
  DISABLED
}

enum ActionDecision {
  ALLOW
  REQUIRE_APPROVAL
  BLOCK
  LOG_ONLY
  SANDBOX_ONLY
}

enum RiskLevel {
  NONE
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActionStatus {
  REQUESTED
  ALLOWED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  BLOCKED
  EXECUTED
  FAILED
  CANCELLED
  EXPIRED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EDITED
  EXPIRED
  CANCELLED
  AUTO_APPROVED
  AUTO_BLOCKED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum BillingPlan {
  FREE
  STARTER
  AGENCY
  BUSINESS
  ENTERPRISE
}

enum BillingStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
  INCOMPLETE
}

enum WebhookEndpointStatus {
  ACTIVE
  DISABLED
}

model Organization {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  plan              BillingPlan        @default(FREE)
  status            OrganizationStatus @default(ACTIVE)
  killSwitchEnabled Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  memberships         Membership[]
  agents              Agent[]
  apiKeys             ApiKey[]
  toolConnections     ToolConnection[]
  policies            Policy[]
  policyRules         PolicyRule[]
  actionRequests      ActionRequest[]
  approvalRequests    ApprovalRequest[]
  approvalComments    ApprovalComment[]
  riskAssessments     RiskAssessment[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  webhookEndpoints    WebhookEndpoint[]
  incidents           Incident[]
  billingSubscription BillingSubscription?
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships       Membership[]
  ownedAgents       Agent[]           @relation("AgentOwner")
  createdApiKeys    ApiKey[]          @relation("ApiKeyCreator")
  createdPolicies   Policy[]          @relation("PolicyCreator")
  createdWebhooks   WebhookEndpoint[] @relation("WebhookEndpointCreator")
  assignedApprovals ApprovalRequest[] @relation("ApprovalAssignee")
  reviewedApprovals ApprovalRequest[] @relation("ApprovalReviewer")
  approvalComments  ApprovalComment[] @relation("ApprovalCommentAuthor")
  notifications     Notification[]
  createdIncidents  Incident[]        @relation("IncidentCreator")
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Agent {
  id               String        @id @default(cuid())
  organizationId   String
  name             String
  slug             String
  description      String?
  ownerUserId      String?
  department       String?
  status           AgentStatus   @default(ACTIVE)
  riskTier         AgentRiskTier @default(STANDARD)
  allowedToolsJson Json
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User?           @relation("AgentOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  apiKeys        ApiKey[]
  actionRequests ActionRequest[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([ownerUserId])
}

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  agentId        String?
  name           String
  keyPrefix      String
  keyHash        String       @unique
  status         ApiKeyStatus @default(ACTIVE)
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent          Agent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)
  createdBy      User?           @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  actionRequests ActionRequest[]

  @@index([organizationId])
  @@index([organizationId, agentId])
  @@index([keyPrefix])
}

model ToolConnection {
  id                   String               @id @default(cuid())
  organizationId       String
  toolType             ToolType
  name                 String
  status               ToolConnectionStatus @default(DEMO)
  encryptedCredentials String?
  configJson           Json?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId, toolType, status])
}

model Policy {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  status         PolicyStatus @default(DRAFT)
  priority       Int          @default(100)
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation("PolicyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  rules          PolicyRule[]
  actionRequests ActionRequest[]

  @@unique([organizationId, name])
  @@index([organizationId, status, priority])
}

model PolicyRule {
  id             String          @id @default(cuid())
  organizationId String
  policyId       String
  tool           ToolType?
  action         String?
  conditionsJson Json
  decision       ActionDecision
  requiredRole   MembershipRole?
  riskOverride   RiskLevel?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  policy       Policy       @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([organizationId, policyId])
  @@index([organizationId, tool, action])
  @@index([organizationId, decision])
}

model ActionRequest {
  id               String         @id @default(cuid())
  organizationId   String
  agentId          String
  apiKeyId         String?
  tool             ToolType
  action           String
  environment      String
  payloadJson      Json
  metadataJson     Json?
  riskScore        Int
  riskLevel        RiskLevel
  decision         ActionDecision
  status           ActionStatus
  requiresApproval Boolean        @default(false)
  policyMatchedId  String?
  reason           String
  idempotencyKey   String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent           Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  apiKey          ApiKey?          @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  policyMatched   Policy?          @relation(fields: [policyMatchedId], references: [id], onDelete: SetNull)
  approvalRequest ApprovalRequest?
  riskAssessments RiskAssessment[]

  @@unique([organizationId, apiKeyId, idempotencyKey])
  @@index([organizationId, agentId])
  @@index([organizationId, riskLevel])
  @@index([organizationId, decision])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

model ApprovalRequest {
  id                String          @id @default(cuid())
  organizationId    String
  actionRequestId   String          @unique
  status            ApprovalStatus  @default(PENDING)
  requiredRole      MembershipRole?
  assignedToId      String?
  reviewedById      String?
  reviewComment     String?
  editedPayloadJson Json?
  expiresAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actionRequest ActionRequest     @relation(fields: [actionRequestId], references: [id], onDelete: Cascade)
  assignedTo    User?             @relation("ApprovalAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  reviewedBy    User?             @relation("ApprovalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  comments      ApprovalComment[]

  @@index([organizationId, status, createdAt])
  @@index([assignedToId])
}

model ApprovalComment {
  id                String   @id @default(cuid())
  organizationId    String
  approvalRequestId String
  authorUserId      String
  body              String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  author          User            @relation("ApprovalCommentAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([organizationId, approvalRequestId, createdAt])
  @@index([authorUserId])
}

model RiskAssessment {
  id              String    @id @default(cuid())
  organizationId  String
  actionRequestId String
  score           Int
  level           RiskLevel
  signalsJson     Json
  explanation     String
  modelVersion    String
  createdAt       DateTime  @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actionRequest ActionRequest @relation(fields: [actionRequestId], references: [id], onDelete: Cascade)

  @@index([organizationId, actionRequestId])
  @@index([organizationId, level, createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorType      String
  actorId        String?
  eventType      String
  targetType     String?
  targetId       String?
  metadataJson   Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, eventType, createdAt])
}

model Notification {
  id             String          @id @default(cuid())
  organizationId String
  userId         String?
  role           MembershipRole?
  type           String
  title          String
  body           String
  readAt         DateTime?
  metadataJson   Json?
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt, createdAt])
  @@index([organizationId, role, readAt, createdAt])
  @@index([organizationId, type, createdAt])
}

model WebhookEndpoint {
  id             String                @id @default(cuid())
  organizationId String
  name           String
  url            String
  secretHash     String?
  status         WebhookEndpointStatus @default(ACTIVE)
  eventsJson     Json
  createdById    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("WebhookEndpointCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@index([createdById])
}

model Incident {
  id             String           @id @default(cuid())
  organizationId String
  title          String
  severity       IncidentSeverity
  status         IncidentStatus   @default(OPEN)
  description    String?
  createdById    String?
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("IncidentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, severity, status])
  @@index([organizationId, createdAt])
}

model BillingSubscription {
  id                   String        @id @default(cuid())
  organizationId       String        @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  plan                 BillingPlan
  status               BillingStatus
  currentPeriodEnd     DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
